# ==========================================
# CONFIGURAÇÕES DO MOTOR OLLAMA (GPU 6GB+ VRAM)
# ==========================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_REASONING_MODEL=qwen2.5:7b-instruct-q4_K_M
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_NUM_CTX=4096
OLLAMA_TEMP_TOOLS=0.1
OLLAMA_TEMP_CREATIVE=0.6
OLLAMA_KEEP_ALIVE=5m

# ==========================================
# CAMINHOS E DIRETÓRIOS (OBSIDIAN & CÓDIGO)
# ==========================================
OBSIDIAN_VAULT_PATH=./obsidian_vault
ALLOWED_CODE_DIRS=.
SQLITE_DB_PATH=./database/hybrid_ai.db
CHROMA_DB_PATH=./database/chroma_db

# ==========================================
# LIMITES E SEGURANÇA DO AGENTE
# ==========================================
MAX_TOOL_ITERATIONS=3
STRICT_OFFLINE_MODE=false
TIMEZONE=America/Sao_Paulo

# ==========================================
# SERVIDOR GUI DESACOPLADO (FASE 4)
# ==========================================
GUI_HOST=127.0.0.1
GUI_PORT=8080

# ==========================================
# CREDENCIAIS OPCIONAIS DOS WORKERS (FASE 5)
# ==========================================
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ACCESS_TOKEN=
WHATSAPP_BRIDGE_PORT=3001
WHATSAPP_PAIRED=false
